{
  "name": "geo-thailand",
  "version": "1.0.0",
  "description": "เกมทายตำแหน่งในประเทศไทย แบบ GeoGuessr รองรับหลายผู้เล่น",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --env-file-if-exists=.env.local server.js\"",
    "start": "node --env-file-if-exists=.env.local server.js",
    "build:provinces": "node scripts/build-provinces.js",
    "build": "npm run build:provinces && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
