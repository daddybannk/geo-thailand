# Copy this file to .env.local and restrict each key to its API and website.
GOOGLE_MAPS_EMBED_API_KEY=your_google_maps_embed_api_key
CARTO_BASEMAP_KEY=your_carto_basemap_key

# ใช้เมื่อแยก deploy frontend (เช่น Vercel) กับ backend (เช่น Render)
# ฝั่ง backend: origin ของ frontend ที่อนุญาต (คั่นด้วย comma)
CLIENT_ORIGIN=https://your-app.vercel.app
# ฝั่ง frontend (ตั้งใน Vercel ตอน build): URL ของ backend
VITE_SERVER_URL=https://your-backend.onrender.com
